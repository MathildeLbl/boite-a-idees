<h1>Les idées de la communauté</h1>

<% if user_signed_in? %>
  <%= link_to "Proposer une idée", new_idea_path, class: "btn btn-success mb-3" %>
<% end %>

<div class="mb-4">
  <%= form_with url: ideas_path, method: :get, local: true, class: "d-flex" do %>
    <%= text_field_tag :q, params[:q], placeholder: "Rechercher par tag...", class: "form-control me-2" %>
    <%= submit_tag "Rechercher", class: "btn btn-primary" %>
  <% end %>
</div>

<h1>Liste des idées</h1>

<%= render @ideas %>

